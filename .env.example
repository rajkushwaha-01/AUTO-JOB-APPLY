# MongoDB Connection URI (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/autojobapply?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens (at least 32 characters)
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters

# Google Gemini API Key for career embeddings & semantic matching
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime environment (Render sets this automatically)
NODE_ENV=production

# Skip downloading Puppeteer Chromium during Render build
PUPPETEER_SKIP_DOWNLOAD=true

